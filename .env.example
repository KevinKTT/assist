# assist — settings for docker compose
#
# HOW TO USE THIS FILE
#   1. Copy it to ".env" next to docker-compose.yml:
#         cp .env.example .env
#   2. Fill in the parts you want. Everything is optional; blank means "off".
#   3. Start it:  docker compose up -d
#
# docker compose reads ".env" automatically. Do not commit your ".env" — it can
# hold secrets. Only this example file is committed.

# ===========================================================================
# WHERE THE APP IS REACHABLE
# ===========================================================================
# Port on the host. Default 8080.
# The app is then at:  http://<host-ip-or-name>:8080
# Over Tailscale through Caddy it is whatever HTTPS name Caddy serves, e.g.
#   https://assist.<your-tailnet>.ts.net
ASSIST_PORT=8080

# ===========================================================================
# WHERE DATA AND BACKUPS LIVE ON THE HOST
# ===========================================================================
# The database (assist.db) is created here on first start.
ASSIST_DATA=./data
# Rotated snapshots are written here (and copied to Seafile if configured).
ASSIST_BACKUPS=./backups

# ===========================================================================
# LOGGING
# ===========================================================================
# One of: DEBUG, INFO, WARNING, ERROR. Default INFO.
ASSIST_LOG_LEVEL=INFO

# ===========================================================================
# DOWN-SERVER ALERTS (optional)
# ===========================================================================
# A URL the app pings on a timer so an outside service notices when it stops.
# Works with healthchecks.io, an ntfy topic, or anything that accepts a GET.
# Leave blank to disable.
#
# Examples:
#   https://hc-ping.com/<your-uuid>
#   https://ntfy.sh/<your-secret-topic>
ASSIST_HEARTBEAT_URL=
# How often to ping, in seconds. Minimum 15. Default 60.
ASSIST_HEARTBEAT_SECONDS=60

# ===========================================================================
# OFF-HOST BACKUPS TO SEAFILE (optional)
# ===========================================================================
# Leave SEAFILE_URL blank to keep backups local only.
#
# SEAFILE_URL  = the base URL of your Seafile server. No trailing slash and no
#                path. The app calls: <SEAFILE_URL>/api2/repos/<repo-id>/...
#
#   Public:     https://seafile.example.com
#   Tailscale:  https://seafile.<your-tailnet>.ts.net
#   LAN http:   http://192.168.1.50:8000
#
SEAFILE_URL=

# SEAFILE_TOKEN = a Seafile API token for your user.
#   Get it from the Seafile web UI: avatar (top right) -> Settings -> "API token",
#   or run:
#     curl -d "username=YOU&password=YOURPASS" https://seafile.example.com/api2/auth-token/
#   (that returns {"token": "..."}).
SEAFILE_TOKEN=

# SEAFILE_REPO_ID = the library (repo) to upload into. Open the library in the
#   Seafile web UI; the id is the long string in the URL:
#     https://seafile.example.com/library/<THIS-IS-THE-REPO-ID>/My%20Library/
SEAFILE_REPO_ID=

# Folder inside that library. Created automatically if missing. Default
# /assist-backups.
SEAFILE_DIR=/assist-backups

# NOTE: when the app uploads, Seafile hands back an upload URL and the app
# posts the file to that. That URL comes from Seafile's own SERVICE_URL /
# FILE_SERVER_ROOT settings, so it must be reachable FROM the assist container.
# If uploads fail with a connection error, check those two Seafile settings
# (or use a Seafile address that resolves from inside the container).
